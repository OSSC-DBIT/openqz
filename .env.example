# ---- General ----
ENVIRONMENT=development
DEBUG=true
PUBLIC_URL=http://localhost
HTTP_PORT=80

# ---- Security ----
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=http://localhost,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1,api,nginx
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false

# Development only: sign in as this account automatically, skipping the sign-in page.
# Ignored unless ENVIRONMENT=development. Blank = normal sign-in page.
# Use an account that exists (scripts/seed_demo.sh creates admin@openqz.dev).
DEV_AUTO_LOGIN_EMAIL=

# Extra hostnames for a dev tunnel (e.g. ngrok); also add them to ALLOWED_HOSTS
VITE_ALLOWED_HOSTS=

# ---- Google sign-in (optional) ----
# OAuth client id from Google Cloud Console (type: Web application). Blank = button hidden.
# Add every site URL (e.g. http://localhost:8088, https://openqz.dbit.co.in) as an
# "Authorised JavaScript origin". No client secret is needed.
GOOGLE_CLIENT_ID=
# Optional comma separated allow-list, e.g. dbit.in. Blank = any Google account whose
# email matches an imported user.
GOOGLE_ALLOWED_DOMAINS=

# ---- Email (optional) ----
# Blank SMTP_HOST = no emails ("forgot password" link hidden, no notifications).
# Dev: compose.dev.yaml points this at Mailpit (http://localhost:8025) automatically.
# Real mail locally (Cloudflare tunnel, compose.mail.yaml) and the sender-domain rule: docs/email.md
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OpenQZ <no-reply@dbit.co.in>
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Postgres ----
POSTGRES_USER=openqz
POSTGRES_PASSWORD=openqz-dev-password
POSTGRES_DB=openqz
# Connections per process; keep (api workers + 1) x (pool + overflow) below 200.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DATABASE_URL=postgresql+asyncpg://openqz:openqz-dev-password@db:5432/openqz

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Media ----
MEDIA_DIR=/data/media
MAX_UPLOAD_MB=10

# ---- First admin (used by `python -m app.cli create-admin --from-env`) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@openqz.dev
ADMIN_PASSWORD=ChangeMe@123
ADMIN_FULL_NAME=OpenQZ Administrator
